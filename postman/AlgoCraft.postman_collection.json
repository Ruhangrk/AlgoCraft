{
  "info": {
    "name": "AlgoCraft API",
    "description": "Local AlgoCraft HTTP API.\n\n1. Start server: `./build/algocraft_engine serve data/1min 8080`\n2. Import this collection + `AlgoCraft.local.postman_environment.json`\n3. Select environment **AlgoCraft Local**\n4. Run **Auth → Register** or **Login** (saves `token` automatically)\n5. Call other routes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8080" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  if (j.token) pm.environment.set('token', j.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Creates a user and returns JWT. Saves `token` to the environment."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  if (j.token) pm.environment.set('token', j.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Login; saves `token` to the environment."
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me",
            "description": "Requires Bearer token."
          }
        }
      ]
    },
    {
      "name": "Catalog",
      "item": [
        {
          "name": "List strategies",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/strategies"
          }
        },
        {
          "name": "List routing algos",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/routing-algos"
          }
        },
        {
          "name": "Search instruments",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/instruments?q=RELI&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["instruments"],
              "query": [
                { "key": "q", "value": "RELI" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "Auth required. Cap limit at 50. Empty q returns []. Needs prior `instruments ingest`."
          }
        },
        {
          "name": "Get instrument",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/instruments/RELIANCE",
            "description": "Auth required. 404 if unknown or inactive."
          }
        },
        {
          "name": "OHLCV chart candles",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/instruments/INFY/ohlcv?resolution=1d&from=2026-01-01&to=2026-03-15",
              "host": ["{{baseUrl}}"],
              "path": ["instruments", "INFY", "ohlcv"],
              "query": [
                { "key": "resolution", "value": "1d", "description": "1d | 1w | 1M only" },
                { "key": "from", "value": "2026-01-01" },
                { "key": "to", "value": "2026-03-15" }
              ]
            },
            "description": "Chart path only. Cold miss may hit Upstox once; warm is Rocks-only (vendor_fetches=0)."
          }
        }
      ]
    },
    {
      "name": "Market data",
      "item": [
        {
          "name": "Ensure data (5 DefaultRouter stocks)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tickers\": [\"RELIANCE\", \"INFY\", \"TCS\", \"HDFCBANK\", \"ICICIBANK\"],\n  \"from\": \"2026-08-18\",\n  \"to\": \"2026-09-11\"\n}"
            },
            "url": "{{baseUrl}}/market-data/ensure",
            "description": "Fills RocksDB via active provider (Upstox if token present). Can take several minutes (rate-limited)."
          }
        }
      ]
    },
    {
      "name": "Workbooks",
      "item": [
        {
          "name": "Create workbook",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  if (j.id != null) pm.environment.set('workbook_id', String(j.id));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"postman-wb\",\n  \"capital_paise\": 100000000\n}"
            },
            "url": "{{baseUrl}}/workbooks",
            "description": "Saves `workbook_id` to the environment."
          }
        },
        {
          "name": "List workbooks",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/workbooks"
          }
        },
        {
          "name": "Start run",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tickers\": [\"RELIANCE\", \"INFY\"],\n  \"strategies\": [\"ema_crossover\"],\n  \"capital_paise\": 100000000,\n  \"router\": \"default_router\"\n}"
            },
            "url": "{{baseUrl}}/workbooks/{{workbook_id}}/runs/start",
            "description": "Starts a CSV/Upstox-backed routing run for the workbook."
          }
        },
        {
          "name": "List runs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/workbooks/{{workbook_id}}/runs"
          }
        },
        {
          "name": "List fills",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/workbooks/{{workbook_id}}/fills"
          }
        },
        {
          "name": "Portfolio",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/workbooks/{{workbook_id}}/portfolio"
          }
        },
        {
          "name": "Containers",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/workbooks/{{workbook_id}}/containers"
          }
        },
        {
          "name": "Start backtest",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  if (j.id != null) pm.environment.set('backtest_id', String(j.id));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticker\": \"RELIANCE\",\n  \"strategy\": \"ema_crossover\",\n  \"capital_paise\": 10000000,\n  \"from_ns\": 1787027100000000000,\n  \"to_ns\": 1787113500000000000,\n  \"order_qty\": 1,\n  \"ema_fast\": 9,\n  \"ema_slow\": 21\n}"
            },
            "url": "{{baseUrl}}/workbooks/{{workbook_id}}/backtests/start",
            "description": "Sync manual backtest (ensure 1m → run → persist). Saves `backtest_id`. from_ns/to_ns must cover cached 1m data."
          }
        },
        {
          "name": "List backtests",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/workbooks/{{workbook_id}}/backtests"
          }
        },
        {
          "name": "Get backtest",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/workbooks/{{workbook_id}}/backtests/{{backtest_id}}"
          }
        }
      ]
    },
    {
      "name": "WS snapshots (poll)",
      "item": [
        {
          "name": "WS portfolio snapshot",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/ws/workbooks/{{workbook_id}}/portfolio",
            "description": "Pollable snapshot (not a live WebSocket upgrade yet)."
          }
        },
        {
          "name": "WS containers snapshot",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/ws/workbooks/{{workbook_id}}/containers"
          }
        }
      ]
    }
  ]
}
